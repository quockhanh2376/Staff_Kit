generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  RETIRED
  DISPOSED
}

enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
}

enum WorkflowSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum WorkflowRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowRequestType {
  RECEIVE
  RETURN
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum AuditResult {
  SUCCESS
  FAILURE
  REJECTED
  DENIED
}

model LocalAccount {
  id                 Int         @id @default(autoincrement())
  accountKey         String      @unique @default(cuid())
  displayName        String
  username           String      @unique
  passwordHash       String
  recoveryCodeHash   String?
  role               AccountRole @default(USER)
  forcePasswordReset Boolean     @default(true)
  isActive           Boolean     @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  receiveSessions    ReceiveSession[] @relation("ReceiveSessionCreator")
  returnSessions     ReturnSession[]  @relation("ReturnSessionCreator")
  approvalReviews    ApprovalReview[]
  auditLogs          AuditLog[]

  @@map("local_accounts")
  @@index([username])
  @@index([role])
  @@index([isActive])
}

model Team {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  parentId  Int?
  parent    Team?      @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Team[]     @relation("TeamHierarchy")
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("teams")
}

model Employee {
  id                   Int                    @id @default(autoincrement())
  employeeId           String                 @unique
  fullName             String
  nickName             String?
  teamId               Int?
  team                 Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project              String?
  jobTitle             String?
  email                String?                @unique
  cellphone            String?
  dateOfBirth          DateTime?
  gender               String?
  aswStartDate         DateTime?
  clientStartDate      DateTime?
  contractEndDate      DateTime?
  clientYearOfServices String?
  startDate            DateTime?
  computerName         String?
  notes                String?
  staffGroup           String                 @default("employee_list")
  dynamicValues        EmployeeDynamicValue[]
  assetAssignments     AssetAssignment[]
  receiveRequests      ReceiveRequest[]
  returnRequests       ReturnRequest[]
  auditLogs            AuditLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("employees")
  @@index([staffGroup])
  @@index([teamId])
}

model Asset {
  id                  Int                 @id @default(autoincrement())
  assetKey            String              @unique @default(cuid())
  assetCode           String              @unique
  name                String
  assetType           String
  status              AssetStatus         @default(IN_STOCK)
  recordedAt          DateTime            @default(now())
  owningUnit          String?
  managingUnit        String?
  serialNumber        String?
  brand               String?
  modelName           String?
  notes               String?
  retiredAt           DateTime?
  disposedAt          DateTime?
  assignments         AssetAssignment[]
  receiveRequestItems ReceiveRequestItem[]
  returnRequestItems  ReturnRequestItem[]
  auditLogs           AuditLog[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("assets")
  @@index([assetCode])
  @@index([status])
  @@index([assetType])
  @@index([recordedAt])
}

model AssetAssignment {
  id                      Int                   @id @default(autoincrement())
  assignmentKey           String                @unique @default(cuid())
  assetId                 Int
  employeeId              Int
  status                  AssetAssignmentStatus @default(ACTIVE)
  receiveRequestItemId    Int?                  @unique
  closedByReturnItemId    Int?                  @unique
  assignedAt              DateTime              @default(now())
  returnedAt              DateTime?
  notes                   String?
  asset                   Asset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee                Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  receiveRequestItem      ReceiveRequestItem?   @relation("ReceiveAssignment", fields: [receiveRequestItemId], references: [id], onDelete: SetNull)
  returnRequestItems      ReturnRequestItem[]   @relation("RequestedReturnAssignment")
  closedByReturnRequestItem ReturnRequestItem?  @relation("ReturnClosure", fields: [closedByReturnItemId], references: [id], onDelete: SetNull)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@map("asset_assignments")
  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@index([assignedAt])
}

model ReceiveSession {
  id                 Int                   @id @default(autoincrement())
  sessionKey         String                @unique @default(cuid())
  qrToken            String                @unique @default(cuid())
  createdByAccountId Int
  status             WorkflowSessionStatus @default(ACTIVE)
  expiresAt          DateTime?
  closedAt           DateTime?
  notes              String?
  createdBy          LocalAccount          @relation("ReceiveSessionCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  requests           ReceiveRequest[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("receive_sessions")
  @@index([qrToken])
  @@index([status])
  @@index([createdByAccountId])
  @@index([expiresAt])
}

model ReceiveRequest {
  id                   Int                   @id @default(autoincrement())
  requestKey           String                @unique @default(cuid())
  sessionId            Int
  employeeId           Int
  status               WorkflowRequestStatus @default(PENDING)
  employeeCodeSnapshot String
  employeeNameSnapshot String
  notes                String?
  submittedAt          DateTime              @default(now())
  finalizedAt          DateTime?
  session              ReceiveSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items                ReceiveRequestItem[]
  approvalReview       ApprovalReview?       @relation("ReceiveRequestApproval")
  auditLogs            AuditLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("receive_requests")
  @@index([sessionId])
  @@index([employeeId])
  @@index([status])
  @@index([submittedAt])
}

model ReceiveRequestItem {
  id                Int              @id @default(autoincrement())
  requestId         Int
  assetId           Int
  assetCodeSnapshot String
  assetNameSnapshot String?
  notes             String?
  request           ReceiveRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignment        AssetAssignment? @relation("ReceiveAssignment")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([requestId, assetId])
  @@map("receive_request_items")
  @@index([assetId])
}

model ReturnSession {
  id                 Int                   @id @default(autoincrement())
  sessionKey         String                @unique @default(cuid())
  qrToken            String                @unique @default(cuid())
  createdByAccountId Int
  status             WorkflowSessionStatus @default(ACTIVE)
  expiresAt          DateTime?
  closedAt           DateTime?
  notes              String?
  createdBy          LocalAccount          @relation("ReturnSessionCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  requests           ReturnRequest[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("return_sessions")
  @@index([qrToken])
  @@index([status])
  @@index([createdByAccountId])
  @@index([expiresAt])
}

model ReturnRequest {
  id                   Int                   @id @default(autoincrement())
  requestKey           String                @unique @default(cuid())
  sessionId            Int
  employeeId           Int
  status               WorkflowRequestStatus @default(PENDING)
  employeeCodeSnapshot String
  employeeNameSnapshot String
  notes                String?
  submittedAt          DateTime              @default(now())
  finalizedAt          DateTime?
  session              ReturnSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items                ReturnRequestItem[]
  approvalReview       ApprovalReview?       @relation("ReturnRequestApproval")
  auditLogs            AuditLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("return_requests")
  @@index([sessionId])
  @@index([employeeId])
  @@index([status])
  @@index([submittedAt])
}

model ReturnRequestItem {
  id                  Int               @id @default(autoincrement())
  requestId           Int
  assetId             Int
  assetAssignmentId   Int
  assetCodeSnapshot   String
  assetNameSnapshot   String?
  notes               String?
  request             ReturnRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetAssignment     AssetAssignment   @relation("RequestedReturnAssignment", fields: [assetAssignmentId], references: [id], onDelete: Restrict)
  finalizedAssignment AssetAssignment?  @relation("ReturnClosure")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([requestId, assetId])
  @@unique([requestId, assetAssignmentId])
  @@map("return_request_items")
  @@index([assetId])
  @@index([assetAssignmentId])
}

model ApprovalReview {
  id                Int                 @id @default(autoincrement())
  reviewKey         String              @unique @default(cuid())
  requestType       WorkflowRequestType
  reviewerAccountId Int
  decision          ApprovalDecision
  receiveRequestId  Int?                @unique
  returnRequestId   Int?                @unique
  notes             String?
  reviewedAt        DateTime            @default(now())
  reviewer          LocalAccount        @relation(fields: [reviewerAccountId], references: [id], onDelete: Restrict)
  receiveRequest    ReceiveRequest?     @relation("ReceiveRequestApproval", fields: [receiveRequestId], references: [id], onDelete: Cascade)
  returnRequest     ReturnRequest?      @relation("ReturnRequestApproval", fields: [returnRequestId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("approval_reviews")
  @@index([requestType])
  @@index([reviewerAccountId])
  @@index([decision])
  @@index([reviewedAt])
}

model AuditLog {
  id                  Int            @id @default(autoincrement())
  eventKey            String         @unique @default(cuid())
  actorAccountId      Int?
  actorUsername       String?
  actionType          String
  entityType          String
  entityId            String?
  entityLabel         String?
  result              AuditResult    @default(SUCCESS)
  reason              String?
  metadata            Json?
  assetId             Int?
  employeeId          Int?
  receiveRequestId    Int?
  returnRequestId     Int?
  approvalReviewId    Int?
  occurredAt          DateTime       @default(now())
  actorAccount        LocalAccount?  @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  asset               Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  employee            Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  receiveRequest      ReceiveRequest? @relation(fields: [receiveRequestId], references: [id], onDelete: SetNull)
  returnRequest       ReturnRequest?  @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  approvalReview      ApprovalReview? @relation(fields: [approvalReviewId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([occurredAt])
  @@index([actorAccountId])
  @@index([actionType])
  @@index([entityType])
  @@index([result])
  @@index([assetId])
  @@index([employeeId])
  @@index([receiveRequestId])
  @@index([returnRequestId])
  @@index([approvalReviewId])
}

model EmployeeDynamicField {
  id        Int                    @id @default(autoincrement())
  key       String                 @unique
  label     String
  values    EmployeeDynamicValue[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("employee_dynamic_fields")
}

model EmployeeDynamicValue {
  id         Int                  @id @default(autoincrement())
  employeeId Int
  fieldId    Int
  value      String?
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field      EmployeeDynamicField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([employeeId, fieldId])
  @@map("employee_dynamic_values")
  @@index([fieldId])
}

model AppSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
