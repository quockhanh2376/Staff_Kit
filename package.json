{
  "name": "staff-kit",
  "private": true,
  "version": "2.2.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b ; vite build",
    "lint": "eslint .",
    "check:frontend": "npm run lint; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run typecheck; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run build",
    "check:tauri": "node ./scripts/run-with-shared-cargo-target.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "check:quality": "npm run check:frontend; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run check:tauri",
    "test:supplemental": "node --experimental-strip-types scripts/borrow-lan-autofill.test.ts; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node --experimental-strip-types scripts/action-icon-ui.test.ts",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "headroom": ".\\.headroom-venv\\Scripts\\headroom.exe",
    "headroom:wrap:codex": ".\\.headroom-venv\\Scripts\\headroom.exe wrap codex",
    "headroom:proxy": ".\\.headroom-venv\\Scripts\\headroom.exe proxy --port 8787",
    "headroom:perf": ".\\.headroom-venv\\Scripts\\headroom.exe perf",
    "codex:headroom": "& .\\scripts\\run-codex-headroom.ps1",
    "codex:direct": "& .\\scripts\\run-codex-headroom.ps1 -NoHeadroom",
    "tauri": "node ./scripts/run-with-shared-cargo-target.mjs tauri.cmd",
    "tauri:dev": "node ./scripts/run-with-shared-cargo-target.mjs tauri.cmd dev",
    "tauri:build": "node ./scripts/run-with-shared-cargo-target.mjs tauri.cmd build",
    "test:tauri": "node ./scripts/run-with-shared-cargo-target.mjs cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "caniuse-lite": "^1.0.30001774",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.9.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  }
}
